+    }
+
+    #[test]
+    fn bios_keyboard_modifiers_follow_make_break() {
+        let root = std::env::temp_dir().join(format!("cm-bios-mods-{}", std::process::id()));
+        let mut m = Machine::new(Vfs::new(root.join("iso"), root.join("run")));
+        let mut cpu = Cpu::new();
+        cpu.wr16(0x480, 0x1e); cpu.wr16(0x482, 0x3e);
+        cpu.wr16(0x41a, 0x1e); cpu.wr16(0x41c, 0x1e);
+        cpu.wr8(0x417, 0xf0); cpu.wr8(0x418, 0xf4); cpu.wr8(0x496, 0x10);
+        scan(&mut m, &mut cpu, &[0x2a, 0x2a]);
+        assert_eq!(cpu.rd8(0x417), 0xf2);
+        scan(&mut m, &mut cpu, &[0x36]);
