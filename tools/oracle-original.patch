+        let (_, _, head, tail) = Self::bios_key_ring(cpu)?;
+        if head == tail { None } else { Some(cpu.rd16(BIOS_DATA + head as u32)) }
+    }
+
+    fn bios_key_get(cpu: &mut Cpu) -> Option<u16> {
+        let (start, end, head, tail) = Self::bios_key_ring(cpu)?;
