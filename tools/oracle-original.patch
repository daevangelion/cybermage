+pub struct RawMouseEvent {
+    time: f64,
+    x: i32,
+    y: i32,
+    buttons: u16,
+    order: usize,
+}
+
+impl RawMouseEvent {
+    fn parse(value: &str, order: usize) -> Result<Self, &'static str> {
+        let error = "--raw-mouse expects TIME:X:Y:BUTTONS, time >= 0, X 0..639, Y 0..239, buttons 0..3";
+        let mut fields = value.split(':');
+        let time: f64 = fields.next().and_then(|s| s.parse().ok()).ok_or(error)?;
+        let x: i32 = fields.next().and_then(|s| s.parse().ok()).ok_or(error)?;
+        let y: i32 = fields.next().and_then(|s| s.parse().ok()).ok_or(error)?;
+        let buttons: u16 = fields.next().and_then(|s| s.parse().ok()).ok_or(error)?;
+        if fields.next().is_some() || !time.is_finite() || time < 0.0 ||
+            !(0..640).contains(&x) || !(0..240).contains(&y) || buttons > 3 {
+            return Err(error);
+        }
+        Ok(Self { time: time.abs(), x, y, buttons, order })
+    }
+}
