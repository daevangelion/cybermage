+impl Mouse {
+    /// A host device event. Guest routing and the Mouse object are not touched.
+    pub fn hardware_event(&mut self, x: i32, y: i32, buttons: u16) {
+        let old_x = self.x.clamp(self.min_x, self.max_x);
+        let old_y = self.y.clamp(self.min_y, self.max_y);
+        let x = x.clamp(self.min_x, self.max_x);
+        let y = y.clamp(self.min_y, self.max_y);
+        self.mickey_x = self.mickey_x.wrapping_add(x - old_x);
+        self.mickey_y = self.mickey_y.wrapping_add(y - old_y);
+        for index in 0..2 {
+            let bit = 1 << index;
+            if buttons & bit != 0 && self.buttons & bit == 0 {
+                self.press_count[index] = self.press_count[index].wrapping_add(1);
+            } else if buttons & bit == 0 && self.buttons & bit != 0 {
+                self.release_count[index] = self.release_count[index].wrapping_add(1);
+            }
+        }
+        self.x = x;
+        self.y = y;
+        self.buttons = buttons;
+    }
+}
