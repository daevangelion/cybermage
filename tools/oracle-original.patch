+    fn bios_key_ring(cpu: &Cpu) -> Option<(u16, u16, u16, u16)> {
+        let start = cpu.rd16(BIOS_KB_START);
+        let end = cpu.rd16(BIOS_KB_END);
+        let head = cpu.rd16(BIOS_KB_HEAD);
+        let tail = cpu.rd16(BIOS_KB_TAIL);
+        if start & 1 != 0 || end & 1 != 0 || end.checked_sub(start)? < 4 ||
+            head < start || head >= end || tail < start || tail >= end ||
+            head & 1 != 0 || tail & 1 != 0 {
+            return None;
+        }
+        Some((start, end, head, tail))
+    }
+
+    fn bios_key_put(cpu: &mut Cpu, key: u16) {
+        let Some((start, end, head, tail)) = Self::bios_key_ring(cpu) else { return; };
+        let next = if tail + 2 == end { start } else { tail + 2 };
+        if next == head { return; } // Full BIOS ring retains unread keys.
+        cpu.wr16(BIOS_DATA + tail as u32, key);
+        cpu.wr16(BIOS_KB_TAIL, next);
+    }
+
+    fn bios_key_peek(cpu: &Cpu) -> Option<u16> {
+        let (_, _, head, tail) = Self::bios_key_ring(cpu)?;
+        if head == tail { None } else { Some(cpu.rd16(BIOS_DATA + head as u32)) }
+    }
+
+    fn bios_key_get(cpu: &mut Cpu) -> Option<u16> {
+        let (start, end, head, tail) = Self::bios_key_ring(cpu)?;
+        if head == tail { return None; }
+        let key = cpu.rd16(BIOS_DATA + head as u32);
+        cpu.wr16(BIOS_KB_HEAD, if head + 2 == end { start } else { head + 2 });
+        Some(key)
+    }
+
+    fn dos_key_get(&mut self, cpu: &mut Cpu) -> Option<u8> {
+        if let Some(scan) = self.dos_key_pending.take() { return Some(scan); }
+        let key = Self::bios_key_get(cpu)?;
+        let ascii = key as u8;
+        if ascii == 0 { self.dos_key_pending = Some((key >> 8) as u8); }
+        Some(ascii)
+    }
