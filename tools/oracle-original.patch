+            cpu.wr8(BIOS_KB_FLAGS3, flags3 | 2);
+            return true;
+        }
+        let extended = flags3 & 2 != 0;
+        cpu.wr8(BIOS_KB_FLAGS3, flags3 & !2);
+        let down = scan & 0x80 == 0;
+        match scan & 0x7F {
+            0x2A | 0x36 => {
+                if !extended { // Ignore PrintScreen's fake E0 Shift bytes.
+                    Self::bios_key_flag(cpu, BIOS_KB_FLAGS,
+                        if scan & 0x7F == 0x2A { 2 } else { 1 }, down);
+                }
+            }
+            0x1D => {
+                Self::bios_key_flag(cpu, if extended { BIOS_KB_FLAGS3 } else { BIOS_KB_FLAGS2 },
+                    if extended { 4 } else { 1 }, down);
+                let held = cpu.rd8(BIOS_KB_FLAGS2) & 1 != 0 || cpu.rd8(BIOS_KB_FLAGS3) & 4 != 0;
+                Self::bios_key_flag(cpu, BIOS_KB_FLAGS, 4, held);
+            }
+            0x38 => {
+                Self::bios_key_flag(cpu, if extended { BIOS_KB_FLAGS3 } else { BIOS_KB_FLAGS2 },
+                    if extended { 8 } else { 2 }, down);
+                let held = cpu.rd8(BIOS_KB_FLAGS2) & 2 != 0 || cpu.rd8(BIOS_KB_FLAGS3) & 8 != 0;
+                Self::bios_key_flag(cpu, BIOS_KB_FLAGS, 8, held);
+            }
+            _ => return false,
+        }
