+        scan(&mut m, &mut cpu, &[0x1d, 0xe0, 0x1d, 0x9d]);
+        assert_eq!(cpu.rd8(0x417), 0xf4); // Right Ctrl still owns aggregate Ctrl.
+        assert_eq!(cpu.rd8(0x418), 0xf4);
+        assert_eq!(cpu.rd8(0x496) & 0x0c, 4);
+        scan(&mut m, &mut cpu, &[0xe0, 0x9d]);
+        assert_eq!(cpu.rd8(0x417), 0xf0);
+        scan(&mut m, &mut cpu, &[0x38, 0xe0, 0x38, 0xb8]);
+        assert_eq!(cpu.rd8(0x417), 0xf8);
+        assert_eq!(cpu.rd8(0x418), 0xf4);
+        scan(&mut m, &mut cpu, &[0xe0, 0xb8, 0x1d, 0xe0, 0x38]);
+        assert_eq!(call(&mut m, &mut cpu, 0x16, 0x0200).al(), 0xfc);
+        assert_eq!(call(&mut m, &mut cpu, 0x16, 0x1200).ax(), 0xf9fc);
+        scan(&mut m, &mut cpu, &[0x9d, 0xe0, 0xb8, 0x2a, 0xe0, 0xaa]);
+        assert_eq!(cpu.rd8(0x417), 0xf2); // PrintScreen fake Shift break is ignored.
+        scan(&mut m, &mut cpu, &[0xaa, 0xe0, 0x2a]);
+        assert_eq!(cpu.rd8(0x417), 0xf0);
+        assert_eq!(cpu.rd8(0x418), 0xf4); // Preserve unrelated lock/system bits.
+        assert_eq!(cpu.rd16(0x41a), cpu.rd16(0x41c)); // No modifier enters BIOS queue.
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn bios_keyboard_ring_services_follow_guest_memory() {
+        let root = std::env::temp_dir().join(format!("cm-bios-keys-{}", std::process::id()));
+        let mut m = Machine::new(Vfs::new(root.join("iso"), root.join("run")));
+        let mut cpu = Cpu::new();
+        cpu.wr16(0x480, 0x1e); cpu.wr16(0x482, 0x3e);
+        cpu.wr16(0x41a, 0x1e); cpu.wr16(0x41c, 0x1e);
+        m.port60 = 0x1e; m.default_irq(&mut cpu, 1);
+        assert_eq!(cpu.rd16(0x41e), 0x1e61);
+        assert_eq!(cpu.rd16(0x41c), 0x20);
+        let r = call(&mut m, &mut cpu, 0x16, 0x0100);
+        assert_eq!(r.ax(), 0x1e61); assert_eq!(r.flags & ZF, 0);
+        assert_eq!(cpu.rd16(0x41a), 0x1e);
+        assert_eq!(call(&mut m, &mut cpu, 0x16, 0).ax(), 0x1e61);
+        m.port60 = 0x30; m.default_irq(&mut cpu, 1);
+        /* The original CM_ISR8 clears these guest BDA words itself. */
+        cpu.wr16(0x41a, cpu.rd16(0x480)); cpu.wr16(0x41c, cpu.rd16(0x480));
+        assert_eq!(call(&mut m, &mut cpu, 0x21, 0x0b00).al(), 0);
+
+        cpu.wr16(0x480, 0x90); cpu.wr16(0x482, 0x98);
+        cpu.wr16(0x41a, 0x90); cpu.wr16(0x41c, 0x90);
+        for scan in [0x1e, 0x30, 0x2e, 0x20] {
+            m.port60 = scan; m.default_irq(&mut cpu, 1);
+        }
+        for expected in [0x1e61, 0x3062, 0x2e63] {
+            assert_eq!(call(&mut m, &mut cpu, 0x16, 0x1000).ax(), expected);
+        }
+        assert_ne!(call(&mut m, &mut cpu, 0x16, 0x1100).flags & ZF, 0);
+        m.port60 = 0x4b; m.default_irq(&mut cpu, 1);
+        assert_eq!(call(&mut m, &mut cpu, 0x21, 0x0b00).al(), 0xff);
+        assert_eq!(call(&mut m, &mut cpu, 0x21, 0x0800).al(), 0);
+        assert_eq!(call(&mut m, &mut cpu, 0x21, 0x0b00).al(), 0xff);
+        assert_eq!(call(&mut m, &mut cpu, 0x21, 0x0800).al(), 0x4b);
+        assert_eq!(call(&mut m, &mut cpu, 0x21, 0x0b00).al(), 0);
+        m.port60 = 0x9e; m.default_irq(&mut cpu, 1);
+        assert_eq!(call(&mut m, &mut cpu, 0x21, 0x0b00).al(), 0);
+        cpu.cur_eip = 0x1234; cpu.eip = 0x1236;
+        assert_eq!(call(&mut m, &mut cpu, 0x21, 0x0800).ax(), 0x0800);
+        assert_eq!(cpu.eip, cpu.cur_eip);
+        cpu.wr16(0x41c, 0x91);
+        m.port60 = 0x1e; m.default_irq(&mut cpu, 1);
+        assert_eq!(cpu.rd16(0x41c), 0x91);
+        assert_eq!(call(&mut m, &mut cpu, 0x21, 0x0b00).al(), 0);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
