+impl Drop for FrameTrace {
+    fn drop(&mut self) {
+        self.flush_pending();
+        if let Some(out) = &mut self.actor_clocks { out.flush().expect("flush actor clocks"); }
+        if let Some(out) = &mut self.rng { out.flush().expect("flush RNG trace"); }
+        if let Some(out) = &mut self.steering { out.flush().expect("flush steering trace"); }
+        if let Some(out) = &mut self.collision { out.flush().expect("flush collision trace"); }
+        if let Some(out) = &mut self.events { out.flush().expect("flush event input trace"); }
+        if let Some(out) = &mut self.items { out.flush().expect("flush item input trace"); }
+        if let Some(out) = &mut self.selectors { out.flush().expect("flush selector input trace"); }
+        self.draw_clocks.flush().expect("flush draw clocks");
+        self.ui_actions.flush().expect("flush UI actions");
+        self.death_inputs.flush().expect("flush death inputs");
+        if let Some(out) = &mut self.mouse_inputs { out.flush().expect("flush mouse inputs"); }
+    }
+}
