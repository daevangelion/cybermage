+    fn bios_key_ring(cpu: &Cpu) -> Option<(u16, u16, u16, u16)> {
+        let start = cpu.rd16(BIOS_KB_START);
+        let end = cpu.rd16(BIOS_KB_END);
+        let head = cpu.rd16(BIOS_KB_HEAD);
+        let tail = cpu.rd16(BIOS_KB_TAIL);
+        if start & 1 != 0 || end & 1 != 0 || end.checked_sub(start)? < 4 ||
