+    fn bios_key_modifier(cpu: &mut Cpu, scan: u8) -> bool {
+        // BDA 40:17/18/96: left/right modifiers and the E0 prefix, not characters.
+        // http://www.techhelpmanual.com/58-keyboard_shift_status_flags.html
+        let flags3 = cpu.rd8(BIOS_KB_FLAGS3);
